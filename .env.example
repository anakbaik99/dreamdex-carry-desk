# Copy to .env and fill in. Never commit the real file.

# The dreamDEX smart wallet that places the orders.
DD_ACCOUNT=

# Venue. Tokyo testnet is chain 50383 and the app region `tokyo`.
DD_CHAIN_ID=50383
DD_REGION=tokyo
DD_APP=https://app.testnet.dreamdex.io
DD_INDEXER=https://hideki-dev.smk.somnia.host/v1/graphql

# Strategy
DD_LOOKBACK_DAYS=7
DD_MIN_CARRY_PCT=4
DD_MAX_POSITIONS=4
DD_GROSS_EXPOSURE_PCT=150
DD_MAX_POSITION_PCT=60
DD_MIN_FREE_MARGIN_PCT=25
DD_EXIT_CARRY_PCT=0
DD_MAX_DRAWDOWN_PCT=15

# Where the order-ticket adapters live
DD_WORKSPACE=/home/ubuntu/scripts/dreamdex
